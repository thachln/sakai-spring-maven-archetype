	<groupId>${groupId}</groupId>
	<artifactId>${artifactId}</artifactId>
	<version>${version}</version>
	<packaging>pom</packaging>
	<name>sakai-spring-maven-archetype</name>
	<description>Archetype to generate a project with sakai and spring</description>

    <!-- Place the source of this project with Sakai's source -->
    <parent>
        <groupId>org.sakaiproject</groupId>
        <artifactId>master</artifactId>
        <version>25.0</version>
        <relativePath>../master/pom.xml</relativePath>
    </parent>

	<dependencyManagement>
		<dependencies>

			<!-- project dependencies -->
			<dependency>
				<groupId>${groupId}</groupId>
				<artifactId>${rootArtifactId}-api</artifactId>
				<version>${version}</version>
				<scope>provided</scope>
			</dependency>

			<dependency>
				<groupId>${groupId}</groupId>
				<artifactId>${rootArtifactId}-impl</artifactId>
				<version>${version}</version>
				<scope>runtime</scope>
			</dependency>

		</dependencies>
	</dependencyManagement>
	<properties>
        <sakai.kernel.version>25.0</sakai.kernel.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.version>5.3.39</spring.version>
        <spring.security.version>5.7.14</spring.security.version>
        <spring.data.commons.version>2.5.12</spring.data.commons.version>
        <spring.data.jpa.version>2.5.12</spring.data.jpa.version>
        <module.version>25.0</module.version>
        <thymeleaf.version>3.0.15.RELEASE</thymeleaf.version>
        
        <!-- More -->
        <sakai.log4j.version>2.24.3</sakai.log4j.version>
        <sakai.slf4j.version>1.7.36</sakai.slf4j.version>
        <sakai.poi.version>5.4.1</sakai.poi.version>
	</properties>

